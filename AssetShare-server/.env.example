DATABASE_URL="postgresql+psycopg://assetshare:assetshare123@localhost:5432/assetshare"

API_PREFIX="/api"
# Comma-separated or JSON array of allowed browser origins
CORS_ORIGINS="http://localhost:8081"

# Session cookie configuration
SESSION_COOKIE_NAME="assetshare_session"
SESSION_TTL_DAYS=7
SESSION_REMEMBER_ME_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
# COOKIE_DOMAIN=""

# Auth endpoint throttling
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SETUP_RATE_LIMIT_MAX_ATTEMPTS=10
SETUP_RATE_LIMIT_WINDOW_SECONDS=300
